{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "sgfr-backend": {
      "root": "SRC/Backend/sgfr",
      "framework": "express"
    },
    "sgfr-frontend": {
      "root": "SRC/Frontend/sgfr",
      "framework": "vite"
    }
  },
  "rewrites": [
   {
      "source": "/api/(.*)",
      "destination": { "service": "sgfr-backend" }
   },
   {
      "source": "/api-docs/(.*)",
      "destination": { "service": "sgfr-backend" }
   },
   {
      "source": "/(.*)",
      "destination": { "service": "sgfr-frontend" }
   }
}
