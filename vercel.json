{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "sgfr-backend": {
      "root": "SRC/Backend/sgfr",
      "framework": "express",
      "entrypoint": "src/index.ts",
      "installCommand": "npm install"
    },
    "sgfr-frontend": {
      "root": "SRC/Frontend/sgfr",
      "framework": "vite",
      "installCommand": "npm install",
      "buildCommand": "npm run build"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "sgfr-backend" }
    },
    {
      "source": "/api-docs/(.*)",
      "destination": { "service": "sgfr-backend" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "sgfr-frontend" }
    }
  ]
}