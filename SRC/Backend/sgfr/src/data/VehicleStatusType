import {Schema, model, InferSchemaType} from  'mongoose';

const vehicleStatusTypeSchema = new Schema({
    statusName: {type: Schema.Types.ObjectId, ref: 'VehicleType'},
},{timestamps: true})

//lee el schema y arma el tipo
export type VehicleStatusType = InferSchemaType<typeof vehicleStatusTypeSchema>;

//registra el schema y devuelve un modelo (objeto para consultar y escribir en la coleccion)
const VehicleStatusTypeModel = model<VehicleStatusType>('Vehicle', vehicleStatusTypeSchema);